# Build + machine state — never commit
*-state.env
.build/
.work/
*.log
_b_*.log

# Runtime deploy artifacts (regenerated by the toolkit)
.bedrock_agentcore/
.bedrock_agentcore.yaml
lib/runtime/ssm-pol.json

# Python venvs / caches
.venv/
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db

# Rendered doc byproducts
docs/*.pdf
*.jpg

# Node deps for docs/generators
node_modules/

# CDK build output
cdk/cdk.out/
cdk/.build/

# Deploy/destroy transcripts. *.log was already ignored but the stderr sidecar was not, and it
# carries stack ARNs with the live account id. Caught by tools/scan_account_ids.py after the fact.
*.log.err
*.err
